# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Push notifications. Pick any hard-to-guess topic string — it IS the password.
# Anyone who knows the topic name can read your notifications.
NTFY_TOPIC=reo-cre-brief-CHANGE-THIS-a7f3k9

# Where the notification sends you when tapped
BRIEF_URL=https://YOURNAME.github.io/reo-cre-brief/

# Optional: which model writes the brief
BRIEF_MODEL=claude-sonnet-4-6

# Optional: email delivery instead of / alongside push
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_TO=you@gmail.com
